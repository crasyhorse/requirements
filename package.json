{
  "name": "requirements",
  "version": "0.1.0",
  "description": "Electron + Vite + React starter with Vitest.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "electron-vite preview",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "test:e2e": "npm run build && bddgen && playwright test",
    "test:e2e:ui": "npm run build && bddgen && playwright test --ui"
  },
  "dependencies": {
    "@eslint/config-helpers": "^0.6.0",
    "primeicons": "latest",
    "primereact": "latest",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/compat": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/coverage-istanbul": "latest",
    "@vitest/coverage-v8": "4.1.8",
    "electron": "latest",
    "electron-vite": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "jiti": "latest",
    "jsdom": "latest",
    "playwright": "latest",
    "playwright-bdd": "latest",
    "prettier": "latest",
    "typedoc": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
