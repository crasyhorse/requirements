{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": false,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
